# .env.example - Environment variables for Enterprise RAG System

# API Keys (at least one is required)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
# COHERE_API_KEY="..."

# Vector Database Configuration
# Pinecone (if used)
# PINECONE_API_KEY="..."
# PINECONE_ENVIRONMENT="us-west1-gcp"

# Local Vector DB Settings (default)
VECTOR_DB_TYPE="faiss"
VECTOR_DB_PATH="./data/faiss_index.bin"

# LLM Configuration
LLM_MODEL="gpt-4-turbo-preview"
LLM_TEMPERATURE=0.7

# Monitoring (optional)
# LANGSMITH_API_KEY="..."
# LANGSMITH_PROJECT="enterprise-rag"

# For GitHub integration (if needed by other tools)
GITHUB_TOKEN="your_github_token_here"
